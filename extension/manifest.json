{
  "manifest_version": 3,
  "name": "What's Next",
  "version": "0.1.0",
  "description": "Your Goodreads to-read shelf, with Kindle Unlimited status and Kindle prices.",
  "action": { "default_title": "What's Next", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": ["https://www.goodreads.com/*", "https://www.amazon.com/*"]
}
